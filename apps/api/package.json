{
  "name": "@shopify-audit/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "dotenv -e .env -- prisma studio"
  },
  "dependencies": {
    "@shopify-audit/shared": "workspace:*",
    "@prisma/client": "^5.14.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1",
    "@google/generative-ai": "^0.15.0",
    "puppeteer": "^22.12.0",
    "lighthouse": "^12.0.0",
    "chrome-launcher": "^1.1.2",
    "axios": "^1.7.2",
    "cheerio": "^1.0.0",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.15.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "winston": "^3.13.0",
    "dotenv": "^16.4.5",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pdfkit": "^0.13.4",
    "@types/uuid": "^10.0.0",
    "@types/compression": "^1.7.5",
    "prisma": "^5.14.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
